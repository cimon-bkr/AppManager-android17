+    /**
+     * Android 17 (API 37) blocks local network access (including mDNS discovery used for Wireless
+     * debugging) by default for apps targeting API 37+ unless ACCESS_LOCAL_NETWORK is granted.
+     */
+    @UiThread
+    private static void requestLocalNetworkPermissionIfNeeded(@NonNull FragmentActivity activity) {
+        if (Build.VERSION.SDK_INT < 37) {
+            return;
+        }
+        final String permission = "android.permission.ACCESS_LOCAL_NETWORK";
+        if (ContextCompat.checkSelfPermission(activity, permission) != PackageManager.PERMISSION_GRANTED) {
+            ActivityCompat.requestPermissions(activity, new String[]{permission}, 0);
+        }
+    }
